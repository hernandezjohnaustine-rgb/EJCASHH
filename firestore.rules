rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL HELPERS ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // --- VALIDATION HELPERS ---
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'isActivated', 'balance', 'earningsWallet', 'referralCode', 'referredBy', 'createdAt', 'stats'])
        && data.keys().size() >= 9 && data.keys().size() <= 20
        && data.uid is string && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 256
        && data.isActivated is bool
        && data.balance is number
        && data.earningsWallet is number
        && (data.username == null || (data.username is string && data.username.size() <= 32))
        && (data.phoneNumber == null || (data.phoneNumber is string && data.phoneNumber.size() <= 20))
        && (data.displayName == null || (data.displayName is string && data.displayName.size() <= 128))
        && (data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 2048))
        && (data.referralCode == null || (data.referralCode is string && data.referralCode.size() <= 32))
        && (data.referredBy == null || (data.referredBy is string && data.referredBy.size() <= 128))
        && (data.createdAt == null || (data.createdAt is string))
        && (data.lastClaimDate == null || data.lastClaimDate is string)
        && (data.tradingInvested == null || data.tradingInvested is number)
        && (data.tradingEarnings == null || data.tradingEarnings is number)
        && (data.tradingActive == null || data.tradingActive is bool)
        && (data.tradingClaimedToday == null || data.tradingClaimedToday is bool)
        && (data.tradingDaysCompleted == null || data.tradingDaysCompleted is number)
        && (data.stats == null || data.stats is map);
    }

    function isValidTransaction(data) {
      return data.type is string
        && data.amount is number
        && data.timestamp != null;
    }

    // Only allow a lookup doc to contain exactly {uid, email} — nothing
    // else about the account is exposed through these public docs.
    function isValidLookupDoc(data) {
      return data.keys().hasOnly(['uid', 'email'])
        && data.uid is string && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 256;
    }

    // --- COLLECTION RULES ---

    // Connection Test
    match /test/connection {
      allow get: if isSignedIn();
    }

    // Public username -> {uid, email} lookup, used so users can log in
    // with a username before they're authenticated. Only ever stores
    // uid + email, never other profile data, so a public read here
    // can't leak anything sensitive. Writable only by the account owner,
    // and only at creation (no edits/deletes from the client).
    match /usernames/{username} {
      allow get: if true;
      allow create: if isSignedIn()
        && isValidLookupDoc(incoming())
        && incoming().uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Same pattern as /usernames but keyed by phone number, for
    // phone-number login.
    match /phoneNumbers/{phoneNumber} {
      allow get: if true;
      allow create: if isSignedIn()
        && isValidLookupDoc(incoming())
        && incoming().uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Public referral-code -> uid lookup. Registration must confirm a
    // referral code exists BEFORE the account (and therefore auth) exists,
    // so this check can't go through the protected /users collection.
    // Only ever stores a uid, so a public read can't leak anything.
    match /referralCodes/{code} {
      allow get: if true;
      allow create: if isSignedIn()
        && incoming().keys().hasOnly(['uid'])
        && incoming().uid is string && incoming().uid.size() <= 128
        && incoming().uid == request.auth.uid;
      allow update, delete: if false;
    }

    // User Rules
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      
      allow create: if isOwner(userId) 
        && isValidUser(incoming())
        && incoming().uid == userId
        && incoming().isActivated == false
        && incoming().balance == 0
        && incoming().earningsWallet == 0;

      allow update: if isSignedIn() && (
        (isOwner(userId) && isValidUser(incoming()) && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName', 'photoURL', 'isActivated', 'activatedAt', 'balance', 
            'earningsWallet', 'tradingInvested', 'tradingEarnings', 'tradingActive', 
            'tradingClaimedToday', 'tradingDaysCompleted', 'lastClaimDate', 'stats',
            'username', 'phoneNumber', 'avatarSeed', 'avatarStyle',
            'pendingActivationLinkId', 'dailyClaimedToday', 'lastDailyClaimDate'
          ])
          && incoming().uid == existing().uid
          && incoming().email == existing().email
          && incoming().referralCode == existing().referralCode
          && incoming().createdAt == existing().createdAt
        ))
        ||
        (!isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['balance', 'earningsWallet', 'stats'])
          && incoming().uid == existing().uid
          && incoming().email == existing().email
          && incoming().isActivated == existing().isActivated
        )
        ||
        isAdmin()
      );
    }

    match /users {
      allow read: if isSignedIn();
    }

    // Transaction Rules
    match /transactions/{transactionId} {
      allow get, list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() 
        && isValidTransaction(incoming());
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
    }

    // Referral Rules
    match /referrals/{referralId} {
      allow read: if isSignedIn() && (resource.data.referrerId == request.auth.uid || resource.data.refereeId == request.auth.uid);
      allow create: if isSignedIn() && incoming().refereeId == request.auth.uid;
    }

    // Trading Package Rules
    match /trading_packages/{packageId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['daysCompleted', 'lastClaimedAt', 'status']);
    }

    // Withdrawal Requests
    match /withdrawalRequests/{id} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && 
        (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
    }

    // Products (Admin adds, users read)
    match /products/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Orders
    match /orders/{id} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (
        resource.data.buyerId == request.auth.uid || isAdmin()
      );
      allow update: if isAdmin();
    }

  }
}
