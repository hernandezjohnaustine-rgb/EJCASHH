rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    function isSignedIn() { return request.auth != null; }
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    function isMerchantAccount() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isMerchantAccount == true;
    }
    function isDepositAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isDepositAdmin == true;
    }

    match /test/connection {
      allow get: if true;
    }
    match /referralCodes/{code} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    match /usernames/{username} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    match /phones/{phone} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    match /users/{userId} {
      allow get: if true;
      allow list: if isSignedIn();
      allow create: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow update: if isSignedIn();
    }
    match /transactions/{transactionId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isSignedIn();
    }
    match /referrals/{referralId} {
      allow read, create: if isSignedIn();
    }
    match /trading_packages/{packageId} {
      allow read, create, update: if isSignedIn();
    }
    match /withdrawalRequests/{id} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow update: if isAdmin();
    }
    match /products/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }
    match /users/{userId}/notifications/{notifId} {
      allow read, update, delete: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn(); // Allow any signed-in user to send notifications
    }
    match /users/{userId}/paymentMethods/{pmId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }
    match /users/{userId}/devices/{deviceId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isSignedIn() && request.auth.uid == userId;
    }
    match /settings/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /merchants/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin() || (isMerchantAccount() && (resource == null || resource.data.ownerId == request.auth.uid) && request.resource.data.ownerId == request.auth.uid);
    }
    match /users/{userId}/unlockedMerchants/{merchantId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }
    match /gcashSettings/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin() || (isDepositAdmin() && (resource == null || resource.data.ownerId == request.auth.uid) && request.resource.data.ownerId == request.auth.uid);
    }
    match /depositRequests/{id} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        (isDepositAdmin() && exists(/databases/$(database)/documents/gcashSettings/$(resource.data.gcashAccountId)) &&
          get(/databases/$(database)/documents/gcashSettings/$(resource.data.gcashAccountId)).data.ownerId == request.auth.uid)
      );
      allow update: if isAdmin() ||
        (isDepositAdmin() && exists(/databases/$(database)/documents/gcashSettings/$(resource.data.gcashAccountId)) &&
          get(/databases/$(database)/documents/gcashSettings/$(resource.data.gcashAccountId)).data.ownerId == request.auth.uid);
    }
    match /orders/{id} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (
        resource.data.buyerId == request.auth.uid || isAdmin()
      );
      allow update: if isAdmin();
    }
  }
}
